# Dependencies
node_modules/

# TypeScript incremental state. The shipped build artifacts under
# packages/workbench/lib ARE committed: pnpm refuses to run build scripts for a
# git-hosted package unless the exact tarball URL is allowlisted in the profile,
# so the repo carries the built output and an install needs no build step.
*.tsbuildinfo

# Editor / OS noise
.DS_Store
Thumbs.db
*.log

# Packaging output (`pnpm pack`): a tarball of the committed lib, reproducible
# from the working tree, so it is not a source file.
dist/

# Sandbox ACL diagnostics (tool output, never a deliverable) and the generated
# preview page plus its scratch screenshots: `repro/card-preview.mjs` writes the
# HTML from the built bundle, so it is reproducible and not committed.
.acl-reports/
repro/card-preview.html
repro/*.png
